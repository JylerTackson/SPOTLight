# Root .env for docker-compose.yml. Copy to .env (gitignored) and edit. See docs/RUNNING.md.
# Compose reads this file for ${VAR} interpolation only; your SHELL environment wins over it, so
# `unset DATABASE_URL EMBED_URL SYSTEM1_URL` if you exported localhost URLs for native runs.

# ── Mode ────────────────────────────────────────────────────────────────────────────────────────
# local  : everything in Docker on CPU (default)
# hybrid : db + mcp + backend in Docker, system1 + embed native on the AMD GPU box (set the URLs below)
# neon   : db-init + mcp + backend against Neon (set the three *_DATABASE_URL below); add ",models" for CPU models
COMPOSE_PROFILES=local

# ── Build ───────────────────────────────────────────────────────────────────────────────────────
TORCH_VARIANT=cpu                 # cpu | rocm-gfx1151 | rocm-gfx1201 (ROCm needs a Linux host with Docker)
BIND_ADDR=127.0.0.1               # host interface for published ports (0.0.0.0 to expose on the LAN)
DB_PORT=5433                      # host port of the local Postgres (change if db/local_pgvector.sh holds 5433)

# ── Database (local/hybrid: the `db` service; these are dev passwords) ──────────────────────────
POSTGRES_PASSWORD=postgres
SPOT_APP_USER=spot_app_user       # backend login, member of spot_app
SPOT_APP_PASSWORD=spot_app_dev
SPOT_MCP_USER=spot_mcp_user       # mcp login (and system1 call logging), member of spot_mcp_reader
SPOT_MCP_PASSWORD=spot_mcp_dev

# ── Neon (profile neon): the owner URL replaces the db service; services log in as the group members ──
# DATABASE_URL=postgresql://neondb_owner:<pw>@ep-xxxx-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require
# BACKEND_DATABASE_URL=postgresql://spot_app_user:<pw>@ep-xxxx-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require
# MCP_DATABASE_URL=postgresql://spot_mcp_user:<pw>@ep-xxxx-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require
# SYSTEM1_LOGS_DATABASE_URL=   # system1's app.model_calls logging (same as MCP_DATABASE_URL), only with --profile models
# DB_INGEST_ARGS=              # e.g. --force after changing EMBED_MODEL

# ── Models (hybrid: the AMD box; reach it through an SSH tunnel on this machine) ──────────────────
#   ssh -N -L 18082:localhost:8082 -L 18081:localhost:8081 <amd-vm>
# SYSTEM1_URL=http://host.docker.internal:18082
# EMBED_URL=http://host.docker.internal:18081
EMBED_MODEL=Qwen/Qwen3-Embedding-0.6B
EMBED_DIM=1024
# LAYA_CHECKPOINT=/models/checkpoints/run2/best   # fine-tuned Laya, mounted from LAYA_CHECKPOINT_DIR
# LAYA_CHECKPOINT_DIR=./amd/system1/checkpoints
# HF_TOKEN=

# ── Backend ─────────────────────────────────────────────────────────────────────────────────────
TRIAGE_MODE=serial                # serial (Laya flags, rules confirm) | parallel (either escalates)
# Admin token for /api/v1/ops/*, /api/v1/replay/* and POST /api/v1/events* (header X-Admin-Token). Unset -> those
# endpoints answer 503 (closed, never open). `make e2e` reads it from this file. Generate: openssl rand -hex 24
ADMIN_TOKEN=
CORS_ORIGINS=http://localhost:3000    # the dashboard's origin(s), comma-separated
# REQUEST_DEADLINE_S=45               # overall deadline for /flags/{id}/context and /explain
# SYSTEM2_URL=http://host.docker.internal:8083   # unset -> /explain returns the template
# SYSTEM2_API_KEY=
# MCP_AUTH_TOKEN=                 # set when the MCP port is exposed beyond localhost
# Timeouts are sized for CPU; on the AMD GPU the contract defaults are fine:
# SYSTEM1_TIMEOUT_S=5  SYSTEM1_INGEST_TIMEOUT_S=5  EMBED_TIMEOUT_S=10  SEARCH_EMBED_TIMEOUT_S=4  MCP_TIMEOUT_S=15

# CPU vision/OCR (:8084); VLM URL reserved and unused in phase 1.
VISION_HOST=0.0.0.0
VISION_PORT=8084
VISION_MAX_PIXELS=16000000
VISION_THERMAL_TOLERANCE_C=4
VISION_GAUGE_TOLERANCE_PSI=6
VISION_CACHE_SIZE=64
VISION_LOG_LEVEL=info
VISION_LLAMA_URL=
